# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
WIKIPEDIA_CONTACT_EMAIL=your_email@esprit.tn

QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
QDRANT_API_KEY=

# Pin versions once you've tested them (check Docker Hub for current tags)
QDRANT_VERSION=latest
N8N_VERSION=latest
OLLAMA_VERSION=latest
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=Africa/Tunis
QDRANT_VERSION=v1.19.1
OLLAMA_VERSION=0.34.4
N8N_VERSION=2.41.3