# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
WIKIPEDIA_CONTACT_EMAIL=your_email@esprit.tn

QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
RERANKER_URL=http://localhost:8081
QDRANT_API_KEY=

# Pinned: the exact versions tested (Qdrant tags start with v)
QDRANT_VERSION=v1.19.1
N8N_VERSION=2.41.3
OLLAMA_VERSION=0.34.4
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=Africa/Tunis
# Text Embeddings Inference image: 89-x.y = NVIDIA Ada GPUs (RTX 40xx), cpu-x.y = CPU only
RERANKER_VERSION=89-1.9
